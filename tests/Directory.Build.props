<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)AssemblyInfo.cs" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Only treat the VM sibling adapter as buildable when the *physical* sibling
         layout is intact: the Adapter's own csproj reaches core via "..\..\..\neo-riscv-core",
         which only resolves when core and vm share the same real parent directory. A symlink
         that points the VM at a different filesystem tree (e.g. an external drive) breaks that
         reverse reference, so we require it to exist too before attempting a source build.
         Without this, EnableRiscvNodeTestProvider would try to build the Adapter and fail. -->
    <RiscvAdapterProject Condition="Exists('$(MSBuildThisFileDirectory)..\..\neo-riscv-vm\dotnet\Neo.Riscv.Adapter\Neo.Riscv.Adapter.csproj')
                                    and Exists('$(MSBuildThisFileDirectory)..\..\neo-riscv-vm\..\..\..\neo-riscv-core\src\Neo\Neo.csproj')">$(MSBuildThisFileDirectory)..\..\neo-riscv-vm\dotnet\Neo.Riscv.Adapter\Neo.Riscv.Adapter.csproj</RiscvAdapterProject>
    <RiscvAdapterDll>$(MSBuildThisFileDirectory)..\..\neo-riscv-vm\dotnet\Neo.Riscv.Adapter\bin\$(Configuration)\net10.0\Neo.Riscv.Adapter.dll</RiscvAdapterDll>
    <RiscvAdapterDepsJson>$(MSBuildThisFileDirectory)..\..\neo-riscv-vm\dotnet\Neo.Riscv.Adapter\bin\$(Configuration)\net10.0\Neo.Riscv.Adapter.deps.json</RiscvAdapterDepsJson>
    <RiscvHostLibFileName Condition="$([MSBuild]::IsOSPlatform('Windows'))">neo_riscv_host.dll</RiscvHostLibFileName>
    <RiscvHostLibFileName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libneo_riscv_host.dylib</RiscvHostLibFileName>
    <RiscvHostLibFileName Condition="'$(RiscvHostLibFileName)' == ''">libneo_riscv_host.so</RiscvHostLibFileName>
    <RiscvHostLibRelease>$(MSBuildThisFileDirectory)..\..\neo-riscv-vm\target\release\$(RiscvHostLibFileName)</RiscvHostLibRelease>
    <RiscvHostLibDebug>$(MSBuildThisFileDirectory)..\..\neo-riscv-vm\target\debug\$(RiscvHostLibFileName)</RiscvHostLibDebug>
    <RiscvAdapterTestDir>$(TargetDir)RiscvAdapter</RiscvAdapterTestDir>
    <RiscvAdapterLegacyPluginDir>$(TargetDir)Plugins\Neo.Riscv.Adapter</RiscvAdapterLegacyPluginDir>
  </PropertyGroup>

  <Target Name="BuildRiscvAdapterForNodeTests" BeforeTargets="StageRiscvAdapterPluginForNodeTests" Condition="'$(EnableRiscvNodeTestProvider)' == 'true' and '$(RiscvAdapterProject)' != ''">
    <MSBuild Projects="$(RiscvAdapterProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="StageRiscvAdapterPluginForNodeTests" AfterTargets="Build" Condition="'$(EnableRiscvNodeTestProvider)' == 'true'">
    <RemoveDir Directories="$(RiscvAdapterLegacyPluginDir)" Condition="Exists('$(RiscvAdapterLegacyPluginDir)')" />
    <MakeDir Directories="$(RiscvAdapterTestDir)" Condition="Exists('$(RiscvAdapterDll)')" />
    <Copy SourceFiles="$(RiscvAdapterDll)"
          DestinationFiles="$(RiscvAdapterTestDir)\Neo.Riscv.Adapter.dll"
          SkipUnchangedFiles="true"
          Condition="Exists('$(RiscvAdapterDll)')" />
    <Copy SourceFiles="$(RiscvAdapterDepsJson)"
          DestinationFiles="$(RiscvAdapterTestDir)\Neo.Riscv.Adapter.deps.json"
          SkipUnchangedFiles="true"
          Condition="Exists('$(RiscvAdapterDepsJson)')" />
    <Copy SourceFiles="$(RiscvHostLibRelease)"
          DestinationFiles="$(RiscvAdapterTestDir)\$(RiscvHostLibFileName)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(RiscvHostLibRelease)')" />
    <Copy SourceFiles="$(RiscvHostLibDebug)"
          DestinationFiles="$(RiscvAdapterTestDir)\$(RiscvHostLibFileName)"
          SkipUnchangedFiles="true"
          Condition="!Exists('$(RiscvHostLibRelease)') and Exists('$(RiscvHostLibDebug)')" />
  </Target>

</Project>
