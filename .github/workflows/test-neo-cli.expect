#!/usr/bin/expect -f
#
# This script uses expect to test neo-cli
#
set timeout 10

# The smoke test must run from the published output directory so plugin
# discovery resolves against ./Plugins next to neo-cli.dll rather than any
# unrelated repo-root plugin folders.
cd out

# Always validate the packaged plugin bundle inside ./Plugins. Local shells may
# already export NEO_RISCV_HOST_LIB for other tests, which would otherwise
# override the published plugin layout and make this smoke test nondeterministic.
catch { unset env(NEO_RISCV_HOST_LIB) }

# Clean up prior run artifacts so repeated local runs remain deterministic.
catch { file delete -force "test-wallet1.json" }
catch { file delete -force "test-wallet2.json" }

# Start neo-cli
spawn dotnet neo-cli.dll

# Expect the main input prompt
expect {
    "neo> " { }
    "error" { exit 2 }
    timeout { exit 1 }
}

#
# Test 'create wallet'
#
send "create wallet test-wallet1.json\n"

expect {
    "password:" { send "asd\n" }
    "error" { exit 2 }
    timeout { exit 1 }
}

expect {
    "password:" { send "asd\n" }
    "error" { exit 2 }
    timeout { exit 1 }
}

expect {
    "   Address:" { }
    "error" { exit 2 }
    timeout { exit 1 }
}

#
# Test 'create wallet'
#
send "create wallet test-wallet2.json L2ArHTuiDL4FHu4nfyhamrG8XVYB4QyRbmhj7vD6hFMB5iAMSTf6\n"

expect {
    "password:" { send "asd\n" }
    "error" { exit 2 }
    timeout { exit 1 }
}

expect {
    "password:" { send "asd\n" }
    "error" { exit 2 }
    timeout { exit 1 }
}

expect {
    "Address: NUj249PQg9EMJfAuxKizdJwMG7GSBzYX2Y" { }
    "error" { exit 2 }
    timeout { exit 1 }
}

#
# Test 'list address'
#
send "list address\n"

expect {
    "neo> " { }
    "error" { exit 2 }
    timeout { exit 1 }
}

#
# Test 'create address'
#
send "create address\n"

expect {
    "neo> " { }
    "error" { exit 2 }
    timeout { exit 1 }
}

exit 0
