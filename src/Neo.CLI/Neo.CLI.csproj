<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyTitle>Neo.CLI</AssemblyTitle>
    <AssemblyName>neo-cli</AssemblyName>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>neo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(NeoSiblingCoreProject)" Condition="'$(UseSiblingNeoCoreProject)' == 'true'" />
    <ProjectReference Include="..\..\..\neo-riscv-vm\compat\Neo.Riscv.Adapter\Neo.Riscv.Adapter.csproj"
                      ReferenceOutputAssembly="false"
                      Condition="Exists('..\..\..\neo-riscv-vm\compat\Neo.Riscv.Adapter\Neo.Riscv.Adapter.csproj')" />
    <PackageReference Include="Neo" Version="$(NeoPackageVersion)" Condition="'$(UseSiblingNeoCoreProject)' != 'true'" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo.ConsoleService\Neo.ConsoleService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="neo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <RiscvAdapterDll>..\..\..\neo-riscv-vm\compat\Neo.Riscv.Adapter\bin\$(Configuration)\net10.0\Neo.Riscv.Adapter.dll</RiscvAdapterDll>
    <RiscvHostLibRelease>..\..\..\neo-riscv-vm\target\release\libneo_riscv_host.so</RiscvHostLibRelease>
    <RiscvHostLibDebug>..\..\..\neo-riscv-vm\target\debug\libneo_riscv_host.so</RiscvHostLibDebug>
    <RiscvHostLib Condition="Exists('$(RiscvHostLibRelease)')">$(RiscvHostLibRelease)</RiscvHostLib>
    <RiscvHostLib Condition="'$(RiscvHostLib)' == '' and Exists('$(RiscvHostLibDebug)')">$(RiscvHostLibDebug)</RiscvHostLib>
    <RiscvAdapterPluginDir>$(OutDir)Plugins\Neo.Riscv.Adapter</RiscvAdapterPluginDir>
  </PropertyGroup>

  <Target Name="StageRiscvAdapterPlugin" AfterTargets="Build" Condition="Exists('$(RiscvAdapterDll)') and '$(RiscvHostLib)' != ''">
    <MakeDir Directories="$(RiscvAdapterPluginDir)" />
    <Copy SourceFiles="$(RiscvAdapterDll)"
          DestinationFiles="$(RiscvAdapterPluginDir)\Neo.Riscv.Adapter.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(RiscvHostLib)"
          DestinationFiles="$(RiscvAdapterPluginDir)\libneo_riscv_host.so"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemoveIncompleteRiscvAdapterPlugin" AfterTargets="Build" Condition="'$(RiscvHostLib)' == '' and Exists('$(RiscvAdapterPluginDir)')">
    <RemoveDir Directories="$(RiscvAdapterPluginDir)" />
  </Target>

</Project>
