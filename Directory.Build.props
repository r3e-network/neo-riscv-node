<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- Support both local sibling project (for development) and git submodule/subtree (for CI/builds) -->
    <NeoSiblingCoreProject>$(MSBuildThisFileDirectory)..\neo-riscv-core\src\Neo\Neo.csproj</NeoSiblingCoreProject>
    <NeoGitSubmoduleCoreProject>$(MSBuildThisFileDirectory)neo-riscv-core\src\Neo\Neo.csproj</NeoGitSubmoduleCoreProject>
    <NeoPackageVersion>3.10.0</NeoPackageVersion>

    <!-- Priority: 1) Local sibling, 2) Git submodule, 3) NuGet package -->
    <UseSiblingNeoCoreProject Condition="Exists('$(NeoSiblingCoreProject)')">true</UseSiblingNeoCoreProject>
    <UseSiblingNeoCoreProject Condition="'$(UseSiblingNeoCoreProject)' == '' AND Exists('$(NeoGitSubmoduleCoreProject)')">true</UseSiblingNeoCoreProject>
    <UseSiblingNeoCoreProject Condition="'$(UseSiblingNeoCoreProject)' == ''">false</UseSiblingNeoCoreProject>

    <!-- When using git submodule, update the project path -->
    <NeoSiblingCoreProject Condition="!Exists('$(NeoSiblingCoreProject)') AND Exists('$(NeoGitSubmoduleCoreProject)')">$(NeoGitSubmoduleCoreProject)</NeoSiblingCoreProject>
  </PropertyGroup>

</Project>
